# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch (smoke-test screenshots, chrome profiles, caches kept off the full C: drive)
/.tmp
/.npm-cache

# RAG data: NCERT PDFs are copyright ("not to be republished"); the index is regenerated
# from them by rag/build_index.py. Keep both out of git.
/rag/data/

# Solution PDFs (Vedantu, ~785 MB) are third-party copyright for the same reason, and
# rag/build_solutions.py + rag/embed_solutions.py regenerate everything derived from them.
/rag/NCERT_Solutions/

# python
__pycache__/
*.pyc
.venv